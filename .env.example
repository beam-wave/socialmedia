# Copy to .env. Real environment variables override these.
# Every machine runs the same app; content moves through S3 with the Create / Pull buttons.

# --- S3 (all machines) ---
AWS_REGION=ap-south-1
S3_BUCKET=socialmedia-dravya
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Prod only ---
# ADMIN_USER=admin
# ADMIN_PASSWORD=...
# CLOAK_KEY=$(openssl rand -base64 32)
# DATABASE_URL=ecto://postgres:postgres@localhost/socialmedia_prod
# SECRET_KEY_BASE=$(mix phx.gen.secret)
# PHX_HOST=social.example.com
