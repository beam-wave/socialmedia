# Copy to .env. Real environment variables override these.
# Prod and the Mac never talk directly: plan.json and finished content go through S3.

# --- Dev: everything on this machine ---
PRIMARY=true
CONTENT=true
PUBLISH=false
S3_PREFIX=dev

# --- Mac making content for prod ---
# PRIMARY=false
# CONTENT=true
# PUBLISH=false
# S3_PREFIX=prod

# --- Prod ---
# PRIMARY=true
# CONTENT=false
# PUBLISH=true
# S3_PREFIX=prod
# ADMIN_USER=admin
# ADMIN_PASSWORD=...
# CLOAK_KEY=$(openssl rand -base64 32)
# DATABASE_URL=ecto://postgres:postgres@localhost/socialmedia_prod
# SECRET_KEY_BASE=$(mix phx.gen.secret)
# PHX_HOST=social.example.com

# --- S3 (all machines) ---
AWS_REGION=ap-south-1
S3_BUCKET=socialmedia-dravya
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
