{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skip",
    "notes",
    "sources",
    "post"
  ],
  "properties": {
    "skip": {
      "type": "boolean",
      "description": "true when the post can't be made; explain in notes"
    },
    "notes": {
      "type": "string",
      "description": "Short note for the admin: the theme of today's words and anything to double-check"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "post": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "style",
                  "words",
                  "hook"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 34,
                    "description": "Card heading, e.g. '3 words to sound smarter'; the last word gets a scribble"
                  },
                  "title_hi": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "sticker": {
                    "type": "string",
                    "maxLength": 12,
                    "description": "Tiny Gen Z sticker on the heading: No cap, Level up, Main character, Office ready"
                  },
                  "words": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "word",
                        "pos",
                        "say",
                        "en",
                        "hi",
                        "example",
                        "example_hi"
                      ],
                      "properties": {
                        "word": {
                          "type": "string",
                          "maxLength": 14
                        },
                        "pos": {
                          "type": "string",
                          "enum": [
                            "noun",
                            "verb",
                            "adj.",
                            "adv.",
                            "phrase"
                          ]
                        },
                        "say": {
                          "type": "string",
                          "maxLength": 22,
                          "description": "Pronunciation in Devanagari with · between syllables"
                        },
                        "en": {
                          "type": "string",
                          "maxLength": 48,
                          "description": "Short simple English meaning"
                        },
                        "hi": {
                          "type": "string",
                          "maxLength": 44,
                          "description": "Hindi meaning; wrap the main meaning in *stars*"
                        },
                        "example": {
                          "type": "string",
                          "maxLength": 56,
                          "description": "Short everyday sentence; wrap the word in *stars*"
                        },
                        "example_hi": {
                          "type": "string",
                          "maxLength": 56
                        },
                        "en_line": {
                          "type": "string",
                          "maxLength": 70,
                          "description": "wotd only: the meaning written as a sentence, e.g. \"it's staying calm when people try to annoy you.\""
                        }
                      }
                    }
                  },
                  "hook": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "q"
                    ],
                    "properties": {
                      "q": {
                        "type": "string",
                        "maxLength": 60
                      },
                      "q_hi": {
                        "type": "string",
                        "maxLength": 60
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 4
                      }
                    }
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "three",
                      "wotd"
                    ],
                    "description": "three: the 3-word card (post type words); wotd: one word of the day with the rabbit (post type word)"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
