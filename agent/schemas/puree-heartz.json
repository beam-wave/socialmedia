{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skip",
    "notes",
    "sources",
    "post"
  ],
  "properties": {
    "skip": {
      "type": "boolean",
      "description": "true when the post can't be made; explain in notes"
    },
    "notes": {
      "type": "string",
      "description": "Short note for the admin reviewer: what you chose and why, anything to double-check"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "post": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "quotes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "quote": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "quote_hi": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "author": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "note_hi": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "theme": {
                    "type": "string",
                    "enum": [
                      "blush",
                      "midnight",
                      "petal",
                      "dusk"
                    ]
                  },
                  "hook": {
                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string",
                        "maxLength": 90
                      },
                      "q_hi": {
                        "type": "string",
                        "maxLength": 90
                      },
                      "options": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "minItems": 2,
                            "maxItems": 5
                          },
                          {
                            "type": "string",
                            "enum": [
                              "names",
                              "teams"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "q"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "quote",
                  "quote_hi",
                  "theme",
                  "hook"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "quotes"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}