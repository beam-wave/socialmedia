{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skip",
    "notes",
    "sources",
    "post"
  ],
  "properties": {
    "skip": {
      "type": "boolean",
      "description": "true when the post can't be made; explain in notes"
    },
    "notes": {
      "type": "string",
      "description": "Short note for the admin reviewer: what you chose and why, anything to double-check"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "post": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "movies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "title_hi": {
                    "type": "string"
                  },
                  "release_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "badge": {
                    "type": "string",
                    "maxLength": 24
                  },
                  "cast": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 4
                  },
                  "director": {
                    "type": "string"
                  },
                  "genre": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "studio": {
                    "type": "string"
                  },
                  "teaser_url": {
                    "type": "string"
                  },
                  "credit": {
                    "type": "string"
                  },
                  "poster_url": {
                    "type": "string",
                    "description": "Direct URL of the official poster image (jpg/png/webp) from the studio, a trade site or Wikipedia"
                  },
                  "theme": {
                    "type": "string",
                    "enum": [
                      "marquee",
                      "neon",
                      "saffron"
                    ]
                  },
                  "hook": {
                    "type": "object",
                    "properties": {
                      "q": {
                        "type": "string",
                        "maxLength": 90
                      },
                      "q_hi": {
                        "type": "string",
                        "maxLength": 90
                      },
                      "options": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "minItems": 2,
                            "maxItems": 5
                          },
                          {
                            "type": "string",
                            "enum": [
                              "names",
                              "teams"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "q"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "title",
                  "release_date",
                  "badge",
                  "cast",
                  "director",
                  "genre",
                  "language",
                  "studio",
                  "teaser_url",
                  "credit",
                  "poster_url",
                  "hook"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "movies"
          ],
          "additionalProperties": false
        }
      ]
    },
    "retry_after_minutes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 10,
          "maximum": 360
        }
      ],
      "description": "With skip=true: ask the app to try again later (e.g. match still in progress). Null otherwise."
    }
  }
}