{
  "type": "object",
  "additionalProperties": false,
  "required": ["skip", "notes", "sources", "post"],
  "properties": {
    "skip": {"type": "boolean", "description": "true when the post can't be made; explain in notes"},
    "notes": {"type": "string", "description": "Short note for the admin: the angle you chose, and which stats in the chat to double-check"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"title": {"type": "string"}, "url": {"type": "string"}},
        "required": ["title", "url"],
        "additionalProperties": false
      }
    },
    "post": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["posters"],
          "properties": {
            "posters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["headline", "sub", "chat", "features", "cta", "cta_sub", "caption_hook", "theme"],
                "properties": {
                  "headline": {"type": "string", "maxLength": 40, "description": "The promise, under 6 words, one *punch phrase*"},
                  "sub": {"type": "string", "maxLength": 130, "description": "One line on what the reader gets; *stars* make words bold"},
                  "chip": {"type": "string", "maxLength": 22},
                  "chat": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["from", "text"],
                      "properties": {
                        "from": {"type": "string", "enum": ["me", "bot"]},
                        "text": {"type": "string", "maxLength": 140}
                      }
                    }
                  },
                  "win": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["team1", "team2", "p1"],
                    "properties": {
                      "team1": {"type": "string", "maxLength": 5},
                      "team2": {"type": "string", "maxLength": 5},
                      "p1": {"type": "integer", "minimum": 5, "maximum": 95}
                    }
                  },
                  "features": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "maxLength": 24}},
                  "cta": {"type": "string", "maxLength": 22},
                  "cta_sub": {"type": "string", "maxLength": 50},
                  "caption_hook": {"type": "string", "maxLength": 90},
                  "theme": {"type": "string", "enum": ["stadium", "volt", "dusk"]}
                }
              }
            }
          }
        }
      ]
    }
  }
}
